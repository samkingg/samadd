<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.ArabicCrosswordGame" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/arabic_gold</item>
        <item name="colorPrimaryVariant">@color/arabic_gold_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/arabic_blue</item>
        <item name="colorSecondaryVariant">@color/arabic_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/arabic_gold</item>
        <item name="android:statusBarColor">@color/arabic_gold</item>
        
        <!-- Customize your theme here -->
        <item name="android:fontFamily">@font/arabic_font</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:layoutDirection">rtl</item>
    </style>
    
    <!-- Custom button style -->
    <style name="Widget.ArabicCrosswordGame.Button" parent="Widget.Material3.Button">
        <item name="android:textSize">18sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>
    
    <!-- Custom text style -->
    <style name="TextAppearance.ArabicCrosswordGame.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/arabic_gold</item>
        <item name="android:fontFamily">@font/arabic_font_bold</item>
    </style>
    
    <!-- Custom card style -->
    <style name="Widget.ArabicCrosswordGame.Card" parent="Widget.Material3.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">8dp</item>
        <item name="cardBackgroundColor">@color/white</item>
    </style>
</resources>