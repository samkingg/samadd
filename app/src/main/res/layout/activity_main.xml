<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:padding="24dp"
    tools:context=".ui.MainActivity">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoImageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_crossword_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textColor="@color/arabic_gold"
            android:fontFamily="@font/arabic_font_bold"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/subtitleTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="استمتع بتعلم اللغة العربية"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/arabic_font"
            android:gravity="center" />

    </LinearLayout>

    <!-- Menu Buttons -->
    <LinearLayout
        android:id="@+id/menuLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startGameButton"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="@string/start_game"
            android:textSize="18sp"
            android:fontFamily="@font/arabic_font_bold"
            android:backgroundTint="@color/arabic_gold"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueGameButton"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="@string/continue_game"
            android:textSize="18sp"
            android:fontFamily="@font/arabic_font_bold"
            android:backgroundTint="@color/arabic_blue"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_continue"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="@string/settings"
            android:textSize="18sp"
            android:fontFamily="@font/arabic_font_bold"
            android:backgroundTint="@color/arabic_green"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exitButton"
            android:layout_width="280dp"
            android:layout_height="64dp"
            android:text="@string/exit"
            android:textSize="18sp"
            android:fontFamily="@font/arabic_font_bold"
            android:backgroundTint="@color/arabic_red"
            android:textColor="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_exit"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/footerTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تم التطوير باستخدام الذكاء الاصطناعي"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:fontFamily="@font/arabic_font"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>